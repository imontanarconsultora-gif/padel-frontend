<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"] — @(configuration["ClubNombre"] ?? "Pádel Club")</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>

  <!-- ── HEADER ─────────────────────────────────────────── -->
  <header class="site-header">

    <!-- LOGO DEL CLUB (lado izquierdo) -->
    <div class="club-logo-wrap">
      @{
        var logoClub = configuration["ClubLogoUrl"];
        var clubNombre = configuration["ClubNombre"] ?? "Pádel Club";
      }
      @if (!string.IsNullOrEmpty(logoClub))
      {
        <!-- Cuando el club configure su logo, se muestra aquí -->
        <img src="@logoClub" alt="@clubNombre" class="club-logo-img">
      }
      else
      {
        <div class="club-logo-placeholder">LOGO<br>CLUB</div>
      }
      <div>
        <div class="club-nombre">@clubNombre</div>
        <div class="club-subtitulo">@ViewData["HeaderSub"]</div>
      </div>
    </div>

    <!-- LOGO IMONTANAR (lado derecho) -->
    <a href="https://instagram.com/imontanarconsultora" target="_blank" class="imontanar-badge" title="IMontanar · Sistemas & Consultoría">
      <img src="~/img/logo-imontanar.png" alt="IMontanar" class="im-logo">
      <div>
        <div class="im-nombre">IMontanar</div>
        <div class="im-sub">Sistemas & Consultoría</div>
      </div>
    </a>
  </header>

  <!-- ── CONTENIDO ──────────────────────────────────────── -->
  <main>
    @RenderBody()
  </main>

  <!-- ── FOOTER ─────────────────────────────────────────── -->
  <footer class="site-footer">
    <div class="footer-left">
      <img src="~/img/logo-imontanar.png" alt="IMontanar" style="height:28px;opacity:.7;">
      <span>Desarrollado por <strong>IMontanar</strong> · Sistemas & Consultoría · Sunchales, Santa Fe</span>
    </div>
    <span class="footer-copy">© @DateTime.Now.Year</span>
  </footer>

  <div class="toast" id="toast"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@inject IConfiguration configuration
