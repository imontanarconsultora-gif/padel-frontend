@page
@model PadelWeb.Pages.Admin.ConfigModel
@{
    ViewData["Title"] = "Configuración";
    ViewData["ActivePage"] = "Config";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="card" style="max-width:560px;">
  <div class="card-header">
    <span class="card-title">Conexión a la API</span>
  </div>
  <div class="modal-body">
    <div class="form-group">
      <label class="form-label">URL de tu API (.NET + Neon)</label>
      <input class="form-control" id="cfg-api-url" value="@Model.ApiUrl" placeholder="https://tu-api.railway.app">
      <p class="form-hint">Sin barra al final. Configurable en appsettings.json o variable de entorno <code>ApiUrl</code>.</p>
    </div>
    <div style="display:flex;gap:.5rem;margin-bottom:1rem;">
      <button class="btn btn-ghost" id="btn-test" onclick="testConexion()">Probar conexión</button>
    </div>
    <hr style="border:none;border-top:1px solid var(--borde);margin:1.25rem 0;">
    <div class="form-group">
      <label class="form-label">Nombre del club</label>
      <input class="form-control" id="cfg-nombre" value="@Model.ClubNombre" placeholder="Pádel Club">
      <p class="form-hint">Configurable en appsettings.json → <code>ClubNombre</code></p>
    </div>
    <p style="font-size:.78rem;color:var(--gris2);margin-bottom:1rem;">
      ⓘ Los cambios de configuración real van en <code>appsettings.json</code> o variables de entorno en Railway/Render.
    </p>
    <button class="btn btn-primary" onclick="toast('Para cambiar la config, editá appsettings.json', 'ok')">Entendido</button>
  </div>
</div>

<div class="card" style="max-width:560px;margin-top:1rem;">
  <div class="card-header"><span class="card-title">Exportar datos</span></div>
  <div class="modal-body" style="display:flex;gap:.5rem;flex-wrap:wrap;">
    <button class="btn btn-ghost" onclick="exportarAlumnas()">⬇ Alumnos CSV</button>
    <button class="btn btn-ghost" onclick="exportarTurnos()">⬇ Turnos CSV</button>
    <button class="btn btn-ghost" onclick="exportarReservas()">⬇ Reservas CSV</button>
  </div>
</div>

@section Scripts {
<script>
  /* API_URL se define en site.js como proxy local */

  async function testConexion() {
    const btn = document.getElementById('btn-test');
    btn.textContent = 'Probando...'; btn.disabled = true;
    try {
      await apiGet('/api/turnos');
      toast('✓ Conexión con el backend OK', 'ok');
    } catch(e) { toast('Sin conexión: ' + e.message, 'err'); }
    finally { btn.textContent = 'Probar conexión'; btn.disabled = false; }
  }

  async function exportarAlumnas() {
    try {
      const lista = await apiGet('/api/alumnos');
      descargarCSV(['ID','Nombre','Teléfono','Categoría','Activa'],
        lista.map(a => [a.id, a.nombre, a.telefono, a.categoria, a.activa?'Sí':'No']),
        'alumnos');
      toast('alumnos.csv descargado', 'ok');
    } catch(e) { toast(e.message, 'err'); }
  }

  async function exportarTurnos() {
    try {
      const lista = await apiGet('/api/turnos');
      descargarCSV(['ID','Nombre','Día','Hora','Categoría','Máx','Activo'],
        lista.map(t => [t.id, t.nombre, DIAS_FULL[t.diaSemana], t.hora?.slice(0,5), t.categoria, t.maxAlumnos, t.activo?'Sí':'No']),
        'turnos');
      toast('turnos.csv descargado', 'ok');
    } catch(e) { toast(e.message, 'err'); }
  }

  async function exportarReservas() {
    const hoy = new Date().toISOString().slice(0,10);
    try {
      const lista = await apiGet(`/api/reservas?fecha=${hoy}`);
      descargarCSV(['ID','Alumno','Teléfono','Turno','Fecha','Estado','Recordatorio'],
        lista.map(r => [r.id, r.alumnoNombre, r.alumnoTel, r.turnoNombre, r.fechaClase, r.estado, r.recordatorioEnviado?'Sí':'No']),
        'reservas');
      toast('reservas.csv descargado', 'ok');
    } catch(e) { toast(e.message, 'err'); }
  }
</script>
}
