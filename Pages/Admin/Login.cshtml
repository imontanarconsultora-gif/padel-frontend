@page
@model PadelWeb.Pages.Admin.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — Ingresar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
  <style>
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: var(--negro); }

    .login-wrap {
      width: 100%;
      max-width: 360px;
      padding: 1rem;
    }

    .login-card {
      background: var(--bg);
      border-radius: 16px;
      padding: 2.5rem 2rem;
      box-shadow: 0 24px 48px rgba(0,0,0,.4);
    }

    .login-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .login-header img { height: 44px; margin-bottom: 1rem; border-radius: 8px; }

    .login-header h1 {
      font-family: 'Syne', sans-serif;
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .login-header p {
      font-size: .75rem;
      color: var(--gris2);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-top: .25rem;
    }

    .field { display: flex; flex-direction: column; gap: .4rem; margin-bottom: 1rem; }

    .field label { font-size: .78rem; font-weight: 600; color: var(--gris); letter-spacing: .5px; }

    .field input {
      padding: .65rem .85rem;
      border: 1.5px solid var(--borde);
      border-radius: 8px;
      font-size: .9rem;
      font-family: inherit;
      background: #fff;
      transition: border-color .15s;
      outline: none;
    }

    .field input:focus { border-color: var(--negro); }

    .btn-login {
      width: 100%;
      margin-top: .75rem;
      padding: .75rem;
      font-size: .95rem;
      font-weight: 600;
    }

    .error-box {
      background: var(--rojo-l);
      border: 1px solid #f5c6c2;
      color: var(--rojo);
      border-radius: 8px;
      padding: .65rem .9rem;
      font-size: .82rem;
      margin-bottom: 1.25rem;
    }

    .login-footer {
      text-align: center;
      margin-top: 1.5rem;
      font-size: .68rem;
      color: rgba(255,255,255,.2);
      letter-spacing: 1px;
    }
  </style>
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="login-header">
        <img src="~/img/logo-imontanar.png" alt="IMontanar">
        <h1>Panel Admin</h1>
        <p>PÁDEL</p>
      </div>

      @if (!string.IsNullOrEmpty(Model.Error))
      {
        <div class="error-box">@Model.Error</div>
      }

      <form method="post">
        @Html.AntiForgeryToken()
        <div class="field">
          <label for="usuario">Usuario</label>
          <input type="text" id="usuario" name="usuario" autocomplete="username"
                 required autofocus value="@Model.Usuario">
        </div>
        <div class="field">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-primary btn-login">Ingresar</button>
      </form>
    </div>

    <div class="login-footer">IMontanar · Sistemas &amp; Consultoría</div>
  </div>
</body>
</html>
